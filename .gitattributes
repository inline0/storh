# Composer installs this package from the tag's GitHub archive, which is
# built with `git archive` and honours `export-ignore`. Everything listed here
# is development-only, so consumers never download it.

/.github              export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/AGENTS.md            export-ignore
/CLAUDE.md            export-ignore
/SECURITY.md          export-ignore
/bench                export-ignore
/docs                 export-ignore
/phpcs.xml            export-ignore
/phpstan.neon.dist    export-ignore
/phpunit.xml.dist     export-ignore
/scripts              export-ignore
/tests                export-ignore
/tools                export-ignore

# Node tooling is development-only.
/package.json export-ignore
/pnpm-lock.yaml export-ignore
/pnpm-workspace.yaml export-ignore
/tsconfig.json export-ignore
